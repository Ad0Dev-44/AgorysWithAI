generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  ANALYST
}

// NOTE: table is physically named "User" (capital) in the live database.
// No @@map here on purpose -- renaming the physical table is a separate,
// riskier migration. This keeps schema and DB in sync with zero rename risk.
model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(ANALYST)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Users are invited into an existing company at registration time
  // (companyId must reference a Company that already exists).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  refreshTokens     RefreshToken[]
  emailVerification EmailVerification?
  passwordReset     PasswordReset?

  @@index([companyId])
}

// NEW -- required so users can be invited into an existing company.
// Table intentionally has no seed/admin UI yet; create rows directly
// (e.g. via Prisma Studio) until a company-admin flow is built.
model Company {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerification {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  lastSentAt  DateTime?
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  lastSentAt DateTime?
}

// NOTE: table is physically named "Dataset" in the live database. Kept as-is
// (no @@map) to avoid a rename. filepath/columns columns existed in the live
// DB but are unused by the app (the CSV is stored on disk, not in Postgres) --
// they are dropped in the accompanying migration since they were NOT NULL
// and would otherwise break prisma.dataset.create({ data: { companyId, filename } }).
model Dataset {
  id        String   @id @default(uuid())
  companyId String
  filename  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataRecords     DataRecord[]
  kpis            KPI[]
  forecasts       Forecast[]
  recommendations Recommendation[]

  @@index([companyId])
}

model DataRecord {
  id        String   @id @default(uuid())
  datasetId String
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  date      DateTime
  product   String
  revenue   Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([datasetId])
}

// NEW -- did not exist in the live database at all. Field names (date, value)
// match exactly what dataset.service.ts already writes via
// prisma.forecast.createMany({ data: { datasetId, date, value } }).
model Forecast {
  id        String   @id @default(uuid())
  datasetId String
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  date      DateTime
  value     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([datasetId])
}

// NEW -- not yet written to by any code path, but required structurally
// because dataset.service.ts's _count select references `kpis` on Dataset.
model KPI {
  id          String   @id @default(uuid())
  datasetId   String
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  metricName  String
  metricValue Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([datasetId])
}

// NEW -- same reasoning as KPI: required because _count select references
// `recommendations` on Dataset.
model Recommendation {
  id        String   @id @default(uuid())
  datasetId String
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  title     String
  message   String
  createdAt DateTime @default(now())

  @@index([datasetId])
}
