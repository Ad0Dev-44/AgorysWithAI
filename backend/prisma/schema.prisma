generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  name              String?
  email             String             @unique
  passwordHash      String
  role              UserRole           @default(ANALYST)
  isVerified        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  companyId         String?
  emailVerification EmailVerification?
  passwordReset     PasswordReset?
  refreshTokens     RefreshToken[]
  company           Company?           @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Company {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id          String    @id @default(uuid())
  userId      Int       @unique
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  lastSentAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     Int       @unique
  tokenHash  String
  expiresAt  DateTime
  lastSentAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dataset {
  id               String               @id @default(uuid())
  filename         String
  companyId        String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  dataRecords      DataRecord[]
  forecasts        Forecast[]
  kpis             KPI[]
  recommendations  Recommendation[]
  aiInsightEmbeddings AIInsightEmbedding[]
}

model DataRecord {
  id        String   @id @default(uuid())
  datasetId String
  date      DateTime
  product   String
  revenue   Decimal
  createdAt DateTime @default(now())
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model Forecast {
  id        String   @id @default(uuid())
  datasetId String
  date      DateTime
  value     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

model KPI {
  id          String   @id @default(uuid())
  datasetId   String
  metricName  String
  metricValue Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

model Recommendation {
  id        String   @id @default(uuid())
  datasetId String
  title     String
  message   String
  createdAt DateTime @default(now())
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

enum UserRole {
  ADMIN
  MANAGER
  ANALYST
}
