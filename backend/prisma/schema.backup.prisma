generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  ANALYST
}

enum ReportType {
  SUMMARY
  FORECAST
  KPI
  RECOMMENDATION
}

model User {
  id            String         @id @default(uuid())
  companyId      String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)

  name           String
  email          String         @unique
  passwordHash   String
  role           UserRole       @default(ANALYST)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  refreshTokens  RefreshToken[]
  reports         Report[]

  @@map("users")
  decisions Decision[]
}

model Company {
  id          String    @id @default(uuid())
  name        String
  industry    String?
  description String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users        User[]
  datasets      Dataset[]
  reports       Report[]
  
  @@map("companies")
  decisions Decision[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  revoked    Boolean  @default(false)

  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Dataset {
  id          String   @id @default(uuid())

  companyId    String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  filename     String
  uploadDate   DateTime @default(now())

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dataRecords      DataRecord[]
  kpis             KPI[]
  forecasts        Forecast[]
  recommendations  Recommendation[]

  @@index([companyId])
  @@map("datasets")
}

model DataRecord {
  id          String   @id @default(uuid())

  datasetId    String
  dataset      Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  date         DateTime
  product      String

  revenue      Decimal  @db.Decimal(12, 2)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([datasetId])
  @@map("data_records")
}

model KPI {
  id           String   @id @default(uuid())

  datasetId     String
  dataset       Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  metricName    String
  metricValue   Decimal  @db.Decimal(12, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([datasetId])
  @@map("kpis")
}

model Forecast {
  id             String   @id @default(uuid())

  datasetId       String
  dataset         Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  forecastDate    DateTime
  confidence Decimal? @db.Decimal(5,2)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([datasetId])
  @@map("forecasts")
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Recommendation {
  id          String   @id @default(uuid())
  datasetId   String
  dataset      Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  title       String
  message     String
  priority    RecommendationPriority @default(MEDIUM)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([datasetId])
}

model Report {
  id            String      @id @default(uuid())

  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reportType      ReportType

  generatedAt     DateTime    @default(now())

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([companyId])
  @@map("reports")
}

enum DecisionStatus {
  PENDING
  APPROVED
  REJECTED
  IMPLEMENTED
}

model Decision {
  id          String         @id @default(uuid())
  companyId   String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  description String
  status      DecisionStatus  @default(PENDING)

  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
  @@index([createdById])
  @@map("decisions")
}